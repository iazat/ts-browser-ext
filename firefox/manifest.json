{
  "manifest_version": 3,
  "name": "TailExt",
  "version": "1.2.2",
  "description": "Give each browser profile its own Tailscale tailnet, using a local proxy from a companion app, without changing your system VPN settings.",
  "icons": {
    "16": "icons/online-16.png",
    "32": "icons/online-32.png",
    "48": "icons/online-48.png",
    "128": "icons/online-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tailext@iazat.github.io",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "proxy",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/online-16.png",
      "32": "icons/online-32.png",
      "48": "icons/online-48.png",
      "128": "icons/online-128.png"
    }
  }
}
